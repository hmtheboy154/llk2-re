 Public Sub PlayWave(vResID As Variant, Optional vFlags As Variant)
-    m_WaveBuf = LoadResData(vResID, "CUSTOM")
+    Dim wavPath As String
+    Dim fno As Integer
+    Dim fLen As Long
+    wavPath = App.Path & "\assets\sfx\" & CStr(vResID) & ".wav"
+    If Dir$(wavPath) <> "" Then
+        fno = FreeFile
+        Open wavPath For Binary As #fno
