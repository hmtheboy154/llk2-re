+        fLen = LOF(fno)
+        ReDim buf(0 To fLen - 1) As Byte
+        Get #fno, , buf
+        Close #fno
+    Else
+        buf = LoadResData(resId, resType)
+    End If
     fno = FreeFile
     Open outPath For Binary As #fno
     Put #fno, , buf
