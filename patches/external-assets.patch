+++ b/src-llkcn/Mainbas.bas
@@ -109,3 +109,18 @@ Public Sub DelayMs(ms As Integer)
         DoEvents
     Loop
 End Sub
+
+' === External-assets helper (external-assets.patch) ===
+Public Function LoadAssetPic(ByVal stem As String) As Object
+    Dim base As String
+    Dim p As String
+    base = App.Path & "\assets\images\" & stem
+    p = base & ".bmp"
+    If Dir$(p) = "" Then p = base & ".jpg"
+    If Dir$(p) = "" Then p = base & ".gif"
+    If Dir$(p) <> "" Then
+        On Error Resume Next
+        Set LoadAssetPic = LoadPicture(p)
+        On Error GoTo 0
+    End If
+End Function
